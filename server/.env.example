# Local backend configuration

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Connect ONLY to the matching Neon development DB branch for local tests.
# A valid JWT alone does not grant a workspace: create a workspace_member row
# through the database's controlled provisioning process.
# Do not enable ALLOW_DEV_AUTH_BYPASS / ALLOW_DEV_WORKSPACE_FALLBACK.

# Branch-specific Neon Auth configuration used by Flask to verify JWTs.
NEON_AUTH_BASE_URL=https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=
AI_PROVIDER=claude

ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=replace_me