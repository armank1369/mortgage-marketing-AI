# Local backend configuration

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Connect ONLY to the matching Neon development DB branch for local tests.
# A valid JWT alone does not grant a workspace: create a workspace_member row
# through the database's controlled provisioning process.
# Do not enable ALLOW_DEV_AUTH_BYPASS / ALLOW_DEV_WORKSPACE_FALLBACK.

# Branch-specific Neon Auth configuration used by Flask to verify JWTs.
NEON_AUTH_BASE_URL=https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=
AI_PROVIDER=claude

ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=replace_me
# Beta: two-model comparison (docs/MODEL_COMPARISON_BETA.md). Off unless set to true.
# Apply docs/database/model_comparison.sql to the target branch before turning it on.
LUCIE_COMPARE_BETA=false
COMPARE_MODEL_A=anthropic:claude-sonnet-5-5
COMPARE_MODEL_B=openai:gpt-6.1-sol
# Optional: COMPARE_MERGE_MODEL=anthropic:claude-sonnet-5-5 (defaults to model A)
OPENAI_API_KEY=
# Optional: COMPARE_PRICES={"your-gpt-model":[input_usd_per_mtok,output_usd_per_mtok]}
COMPARE_OPENAI_REASONING_EFFORT=low
